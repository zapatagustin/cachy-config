[Unit]
Description=Immich Redis (Valkey)
Wants=network-online.target
After=network-online.target

[Container]
Image=docker.io/valkey/valkey:9@sha256:8e8d64b405ce18f41b8e5ee20aa4687a8ed0022d1298f2ce31cdcf3a76e09411
ContainerName=immich-redis
Network=immich.network
LogDriver=journald

[Service]
# Relative scheduler priority, not a cap: under contention (a game) these
# lose, but on an idle machine they still get every core.
CPUWeight=20
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=default.target
