[Unit]
Description=Quickshell bar
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
# Solo arranca bajo Hyprland (chequea $XDG_CURRENT_DESKTOP). Evita que se
# levante en otras sesiones que comparten graphical-session.target (ej. KDE).
ExecCondition=/usr/lib/systemd/systemd-xdg-autostart-condition "Hyprland" ""
ExecStart=/usr/bin/quickshell -p %h/.config/quickshell/bar
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
